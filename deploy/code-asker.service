# Template: do not copy this file by hand. `deploy/install.sh` fills in @USER@ / @HOME@ / @APP_DIR@ / @PATH@
# for the current user and installs it as /etc/systemd/system/code-asker.service.
[Unit]
Description=code-asker (read-only code viewer + AI chat)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
# CODE_ASKER_ROOT, CODE_ASKER_TOKEN, CODE_ASKER_LISTEN (see README). Keep it chmod 600.
EnvironmentFile=/etc/code-asker.env
# `claude` (Node, installed under the service user) must be found and must see the
# same HOME as your interactive login, otherwise its subscription login is not used.
Environment=HOME=@HOME@
Environment=PATH=@PATH@
ExecStart=@APP_DIR@/bin/code-asker
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
